# Server
PORT=3000

# Auth
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=1h

# Persistence driver
# Values: in-memory | mysql
PERSISTENCE_DRIVER=in-memory

# MySQL/MariaDB (required when PERSISTENCE_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ticketing_system
DB_LOGGING=false
